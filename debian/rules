#!/usr/bin/make -f
# Application en Python sans module installé dans site-packages : le code va dans
# /usr/share/odysseus (privé), dh_python3 le compile à l'installation (py3compile).

%:
	dh $@ --with python3

override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	install -d debian/odysseus/usr/share/odysseus
	cp -r odysseus data debian/odysseus/usr/share/odysseus/
	find debian/odysseus/usr/share/odysseus -name __pycache__ -type d -prune -exec rm -rf {} +
	rm -f debian/odysseus/usr/share/odysseus/data/locale/*.pot

override_dh_python3:
	dh_python3 /usr/share/odysseus
